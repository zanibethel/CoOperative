NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required by the persistent async inference queue. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-to-server auth for governed inference calls
COOPERATIVE_INFERENCE_SHARED_SECRET=

# Local worker is preferred when configured
INFERENCE_LOCAL_URL=
INFERENCE_LOCAL_TOKEN=

# Temporary/remote GPU worker fallback
INFERENCE_CLOUD_URL=
INFERENCE_CLOUD_TOKEN=

# Vercel environment-variable changes require a fresh deployment.

# Optional local worker model overrides (set on the worker machine, not Vercel)
FAST_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
QUALITY_MODEL_ID=segmind/SSD-1B
PRELOAD_PROFILE=fast

# Optional worker-side override. Defaults to the production CoOperative AI URL.
COOPERATIVE_QUEUE_URL=https://co-operative-mu.vercel.app
COOPERATIVE_WORKER_ID=
COOPERATIVE_QUEUE_POLL_SECONDS=3

# Redeploy trigger for async inference queue env refresh.

# Optional Apple Silicon text worker model overrides
TEXT_FAST_MODEL_ID=mlx-community/Qwen3-4B-Instruct-2507-4bit
TEXT_QUALITY_MODEL_ID=mlx-community/Qwen2.5-7B-Instruct-4bit
COOPERATIVE_TEXT_WORKER_ID=
COOPERATIVE_TEXT_QUEUE_POLL_SECONDS=3

# Optional governed OpenAI paid-escalation executor.
# Disabled unless OPENAI_ESCALATION_ENABLED=true and a model/API key are configured.
# Pricing is configuration, not hardcoded, so CoOperative can re-evaluate current provider economics.
OPENAI_ESCALATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_ESCALATION_MODEL_ID=
OPENAI_ESCALATION_QUALIFIED=false
OPENAI_ESCALATION_BENCHMARK_SUCCESS_RATE=
OPENAI_ESCALATION_MAX_INPUT_CHARACTERS=
OPENAI_ESCALATION_INPUT_USD_PER_MILLION=
OPENAI_ESCALATION_OUTPUT_USD_PER_MILLION=
OPENAI_ESCALATION_BUSINESS_OWNED=false


# Hermes media generation inside on-demand Vercel Sandbox.
# NOUS_API_KEY powers the cheap/free Hermes orchestrator and Nous-managed image generation.
NOUS_API_KEY=
HERMES_CLOUD_MODEL=poolside/laguna-s-2.1:free

# Image generation defaults to the Nous Tool Gateway.
HERMES_IMAGE_PROVIDER=openrouter
HERMES_IMAGE_MODEL=inclusionai/ming-image-0.1-design

# Video generation uses Hermes' OpenRouter video backend.
# Start with the free Seedance route for smoke tests; higher paid tiers remain policy-gated.
OPENROUTER_API_KEY=
HERMES_VIDEO_PROVIDER=openrouter
HERMES_VIDEO_MODEL=bytedance/seedance-2.0-fast:free
